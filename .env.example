# Runtime configuration. Copy to .env and adjust for your environment.
# Every value is optional; defaults are safe for local review.

ASDLC_DB_PATH=var/agentic_sdlc.db
ASDLC_DATA_DIR=var
ASDLC_ARTIFACT_ROOT=var/runs
ASDLC_PUBLIC_BASE_URL=http://localhost:8000

# Prototype auth. Replace in any shared environment.
ASDLC_API_KEY=dev-key

# Privacy salt for visitor hashes. Rotate deliberately: rotation changes uniqueness.
ASDLC_ANALYTICS_SALT=change-me-in-production

# Shortener limits
ASDLC_MAX_URL_LENGTH=2048
ASDLC_RATE_LIMIT_PER_MINUTE=240
ASDLC_REDIRECT_RATE_LIMIT_PER_MINUTE=1200

# Orchestration
ASDLC_MAX_PARALLEL=4
ASDLC_MAX_WALL_SECONDS=180
ASDLC_MAX_STAGE_ATTEMPTS=120
ASDLC_RETRY_BASE_DELAY=0.08
ASDLC_RETRY_MAX_DELAY=1.0
ASDLC_ENV=development
ASDLC_CHANGE_FREEZE=0

# Agent mode: reference (deterministic, default) or llm
ASDLC_AGENT_MODE=reference
ASDLC_LLM_BASE_URL=https://api.openai.com/v1
ASDLC_LLM_API_KEY=
ASDLC_LLM_MODEL=gpt-4o-mini
ASDLC_LLM_TIMEOUT_SECONDS=30
